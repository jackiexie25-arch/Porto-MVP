# Copy to .env.local and fill in. Never commit real values.
# Supabase project must be in Sydney (ap-southeast-2).
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# The anon (public) key only. Never put the service-role key in any VITE_ variable.
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
# Shown on the consent and privacy screens.
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com
